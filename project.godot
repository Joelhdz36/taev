; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TAEV"
run/main_scene="uid://cyyolaqinmppd"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

CameraManager="*res://data/camera_manager.gd"
GUIDE="*res://addons/guide/guide.gd"
InventoryManager="*res://data/globals/inventory_manager.gd"
HealthManager="*res://data/globals/health_manager.gd"
SceneManager="*res://data/globals/scene_manager.gd"
DataManager="*res://data/globals/data_manager.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
DialogueManager="*res://data/dialogue_manager.gd"

[dialogic]

directories/dch_directory={
"Mads": "res://assets/dialogos/personajes/Mads.dch",
"character": "res://joel/trash/CustomBaseStyle/character.dch"
}
directories/dtl_directory={
"mads_start": "res://assets/dialogos/timelines/mads/mads_start.dtl",
"periodico": "res://assets/dialogos/timelines/mads/periodico.dtl",
"room_blocked": "res://assets/dialogos/timelines/puertas_bloqueadas/room_blocked.dtl",
"room_lobotomia": "res://assets/dialogos/timelines/puertas_bloqueadas/room_lobotomia.dtl",
"room_mads": "res://assets/dialogos/timelines/puertas_bloqueadas/room_mads.dtl",
"room_pas_izq": "res://assets/dialogos/timelines/puertas_bloqueadas/room_pas_izq.dtl",
"simbolo": "res://assets/dialogos/timelines/simbolo.dtl",
"timeline_test": "res://joel/trash/timeline_test.dtl",
"tubo": "res://assets/dialogos/timelines/mads/tubo.dtl"
}
layout/style_directory={
"": "res://assets/dialogos/dialogue_style.tres",
"dialogue_style": "res://assets/dialogos/dialogue_style.tres"
}
layout/style_list=["res://assets/dialogos/dialogue_style.tres"]
layout/default_style="res://assets/dialogos/dialogue_style.tres"
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
audio/type_sound_bus="SFX"
variables={
"first_dialogue": false,
"simbolo": false
}

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"

[editor]

movie_writer/movie_file="C:/Users/DICIS/Videos/video_inventario.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/godot_resource_groups/plugin.cfg", "res://addons/godot_state_charts/plugin.cfg", "res://addons/guide/plugin.cfg")

[global_group]

Enemigo=""

[godot_resource_groups]

auto_rebuild=true

[gui]

fonts/dynamic_fonts/use_oversampling=false
theme/custom_font="uid://bsnrxhuiv7h1w"

